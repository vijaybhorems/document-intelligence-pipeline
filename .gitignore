# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*-key.json
service-account*.json

# Data: CUAD downloads, parse caches, gold labels, eval outputs.
# Only the frozen split definition is versioned.
data/*
!data/splits.json
*.duckdb
*.duckdb.wal

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Notebooks
.ipynb_checkpoints/

# OS / editors
.DS_Store
.idea/
.vscode/

# Terraform (infra/terraform): lock file is committed; working dir and plans are not.
infra/terraform/.terraform/
# Personal settings (alert emails): never in the public repo.
infra/terraform/*.auto.tfvars
